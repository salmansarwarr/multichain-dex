# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already excluded via .gitignore.

# --- RPC URLs ---
# BSC Testnet (Chapel). Public default in hardhat.config.ts works for read-only
# checks, but get your own key (e.g. from a provider like Ankr/QuickNode) for
# anything beyond light testing.
BSC_TESTNET_RPC_URL=https://bsc-testnet.publicnode.com

# BSC Mainnet — only needed from Phase 10 onward.
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org

# Ethereum Sepolia — get a key from Alchemy or Infura.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Ethereum Mainnet — only needed from Phase 10 onward.
ETH_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# --- Deployer / owner key ---
# Only required starting Phase 4 (testnet deployment). Use a dedicated
# throwaway dev wallet for testnets — never your personal/mainnet key.
# For mainnet (Phase 10), the fee-adjustment owner should be a multisig,
# not a raw EOA private key here.
DEPLOYER_PRIVATE_KEY=

# --- Fee wallet addresses ---
# Where the 0.15% swap fee gets sent on each chain.
BSC_FEE_WALLET_ADDRESS=
ETH_FEE_WALLET_ADDRESS=

# --- Block explorer API keys (for contract verification, Phase 4) ---
ETHERSCAN_API_KEY=

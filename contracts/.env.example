# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already excluded via .gitignore.

# --- RPC URLs ---
# BSC Testnet (Chapel). Public default in hardhat.config.ts works for read-only
# checks, but get your own key (e.g. from a provider like Ankr/QuickNode) for
# anything beyond light testing.
BSC_TESTNET_RPC_URL=https://bsc-testnet.publicnode.com

# BSC Mainnet — only needed from Phase 10 onward.
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org

# Ethereum Sepolia — get a key from Alchemy or Infura.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Ethereum Mainnet — only needed from Phase 10 onward.
ETH_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Arbitrum Sepolia (testnet) — public RPC works for light testing.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Arbitrum One (mainnet) — only needed from Phase 10 onward.
ARBITRUM_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc

# --- Deployer / owner key ---
# Only required starting Phase 4 (testnet deployment). Use a dedicated
# throwaway dev wallet for testnets — never your personal/mainnet key.
# For mainnet (Phase 10), the fee-adjustment owner should be a multisig,
# not a raw EOA private key here.
DEPLOYER_PRIVATE_KEY=

# --- Fee wallet addresses ---
# Where the 0.15% swap fee gets sent on each chain.
# Project fee wallet: 0x12e260D0a664736593173f335FcDcc1076eEA4De
BSC_FEE_WALLET_ADDRESS=0x12e260D0a664736593173f335FcDcc1076eEA4De
ETH_FEE_WALLET_ADDRESS=0x12e260D0a664736593173f335FcDcc1076eEA4De
ARB_FEE_WALLET_ADDRESS=0x12e260D0a664736593173f335FcDcc1076eEA4De

# --- Mainnet owners (fee-adjustment rights) ---
# Only needed for deploy-bsc-mainnet.ts / deploy-eth-mainnet.ts /
# deploy-arbitrum-mainnet.ts. Strongly recommended: a multisig (e.g. Gnosis
# Safe) address, NOT a single hot wallet — whoever holds this key can change
# the fee wallet and fee rate on a live mainnet contract. Set this to the
# CLIENT'S wallet address if they should own the contract from deployment —
# there is no ownership-transfer step needed if you do.
# If left blank, the corresponding deploy script falls back to the deployer
# address and prints a loud warning — not recommended for mainnet.
BSC_MAINNET_OWNER_ADDRESS=
ETH_MAINNET_OWNER_ADDRESS=
ARB_MAINNET_OWNER_ADDRESS=

# --- Block explorer API keys (for contract verification, Phase 4) ---
ETHERSCAN_API_KEY=

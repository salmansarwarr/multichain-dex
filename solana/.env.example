# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already excluded via .gitignore.

# --- RPC URLs ---
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# --- Jupiter Aggregator API ---
# IMPORTANT: Jupiter deprecated the old key-free `quote-api.jup.ag/v6`
# endpoint on 1 Oct 2025. The current API requires a free API key from
# https://portal.jup.ag (the "Jupiter Developer Platform") even on the
# free tier. Get one and set it below — without it, every call in
# src/jupiterService.ts fails fast with a clear JupiterConfigError before
# any network request is made.
JUPITER_API_KEY=
JUPITER_QUOTE_API_URL=https://api.jup.ag/swap/v1/quote
JUPITER_SWAP_API_URL=https://api.jup.ag/swap/v1/swap
# Alternative free-tier host (no separate key needed historically, but
# Jupiter's docs now recommend migrating off this — deprecation is
# "paused" with no firm date, so treat it as a fallback, not the default):
#   JUPITER_QUOTE_API_URL=https://lite-api.jup.ag/swap/v1/quote
#   JUPITER_SWAP_API_URL=https://lite-api.jup.ag/swap/v1/swap

# --- Fee account ---
# Your platform fee is collected via Jupiter's native `platformFeeBps`
# parameter, set on the /quote request. This MUST be paired with a
# `feeAccount` on the /swap request — an Associated Token Account (ATA)
# owned by your fee wallet, in the SAME mint as the swap's OUTPUT token
# for ExactIn swaps (our default; INPUT token mint for ExactOut). Jupiter
# pays fees in whatever token comes out of the swap — not auto-converted
# — so you'll typically need one ATA per token you expect to collect fees
# in. See src/feeAccount.ts.
SOLANA_FEE_WALLET_ADDRESS=
JUPITER_PLATFORM_FEE_BPS=15

# --- Test wallets ---
# Devnet wallet: safe to use for anything that ISN'T a Jupiter swap
# (Jupiter only routes against mainnet liquidity — see
# docs/testing-phase3.md). Base58-encoded secret key or path to a
# keypair JSON file.
DEVNET_TEST_WALLET_SECRET_KEY=

# Mainnet smoke-test wallet: ONLY used by
# scripts/mainnet-swap-smoke-test.ts, which is opt-in and executes a
# REAL swap with REAL funds (a tiny amount, e.g. 0.01 SOL, but still
# real money). Do not set this unless you intend to run that specific
# script deliberately — see its header comment and
# docs/testing-phase3.md before using it. Never commit a funded key here.
MAINNET_SMOKE_TEST_WALLET_SECRET_KEY=
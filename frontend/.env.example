# Copy this file to .env.local (Next.js convention) and fill in real values.
# NEVER commit the real .env.local file — it is already excluded via .gitignore.
#
# NEXT_PUBLIC_ prefixed vars are exposed to the browser — do not put secrets
# there. RPC URLs below are fine to expose (they're read-only public
# endpoints or rate-limited provider keys scoped for client-side use).

# --- WalletConnect ---
# Get a free project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- EVM RPC URLs (client-side reads/quotes) ---
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://bsc-testnet.publicnode.com
NEXT_PUBLIC_BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_ETH_MAINNET_RPC_URL=https://eth.llamarpc.com

# --- Arbitrum RPC URLs ---
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_ARBITRUM_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc

# --- Deployed contract addresses (Phase 4, redeployed 2026-08-05) ---
NEXT_PUBLIC_BSC_FEE_ROUTER_ADDRESS=0x6D303DCA98459736c00FfF0507ddA414CbBF0792
NEXT_PUBLIC_ETH_FEE_ROUTER_ADDRESS=0xF27443aAdBaE8611Db6d4164ac4560eF73fa6b64
NEXT_PUBLIC_ARB_FEE_ROUTER_ADDRESS=0x327d2Dc9977eD987E2EB8658EfE823d71C65e614

